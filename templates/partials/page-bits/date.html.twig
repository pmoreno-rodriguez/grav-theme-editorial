{# Date fallback order: publish_date → page.date → page.modified #}
{% set raw_date = page.header.publish_date ?: (page.date ?: page.modified) %}

{% set intl_available = config.plugins.intl.enabled|default(false) %}

{% if intl_available %}
  {% include 'partials/page-bits/date-intl.html.twig' with {raw_date: raw_date} %}
{% else %}
  {% include 'partials/page-bits/date-fallback.html.twig' with {raw_date: raw_date} %}
{% endif %}
